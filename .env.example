# ==============================================================================
# CONNECTING DOTS V2 - ROOT ENVIRONMENT TEMPLATE (.env.example)
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to `.env` in the repo root and fill in your real values.
#   cp .env.example .env
#
# This single file drives:
#   - Docker Compose (docker-compose.yml / docker-compose.prod.yml)
#   - Local dev scripts (start-system.ps1, restart-system.ps1)
#   - All Spring Boot microservices (vars are injected at startup)
#
# For the Next.js frontend, see: connecting-dots-frontend/.env.example
# ==============================================================================


# ------------------------------------------------------------------------------
# 1. DATABASE — Neon PostgreSQL (used by: core-service)
# Get your connection string from: https://console.neon.tech
# ------------------------------------------------------------------------------
DB_URL=jdbc:postgresql://ep-example-pooler.us-east-2.aws.neon.tech/connecting_dots?sslmode=require
DB_USERNAME=connecting_dots_owner
DB_PASSWORD=your_neon_db_password_here

# Spring Boot alias — must match DB_URL/USERNAME/PASSWORD above
SPRING_DATASOURCE_URL=jdbc:postgresql://ep-example-pooler.us-east-2.aws.neon.tech/connecting_dots?sslmode=require
SPRING_DATASOURCE_USERNAME=connecting_dots_owner
SPRING_DATASOURCE_PASSWORD=your_neon_db_password_here


# ------------------------------------------------------------------------------
# 2. CACHING & RATE LIMITING — Upstash Redis (used by: core-service, ai-service, gateway-service)
# Get credentials from: https://console.upstash.com → Redis
# ------------------------------------------------------------------------------
REDIS_URL=rediss://default:your_redis_password@your_host.upstash.io:6379
REDIS_HOST=your_host.upstash.io
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here


# ------------------------------------------------------------------------------
# 3. ASYNC QUEUE — Upstash QStash (used by: core-service)
# Get credentials from: https://console.upstash.com → QStash
# ------------------------------------------------------------------------------
QSTASH_URL=https://qstash.upstash.io/v2/publish/
QSTASH_TOKEN=your_upstash_qstash_bearer_token_here
QSTASH_CURRENT_SIGNING_KEY=sig_your_current_qstash_signing_key_here
QSTASH_NEXT_SIGNING_KEY=sig_your_next_qstash_signing_key_here

# Webhook URL for the AI Service — auto-updated by start-system.ps1
# Local dev:  http://localhost:8082/api/v1/ai/webhook
# Tunnel mode: set automatically via localhost.run SSH tunnel
AI_WEBHOOK_URL=http://localhost:8082/api/v1/ai/webhook


# ------------------------------------------------------------------------------
# 4. MEDIA STORAGE — Cloudinary (used by: core-service)
# Get credentials from: https://cloudinary.com/console
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name_here
CLOUDINARY_API_KEY=your_cloudinary_api_key_here
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here


# ------------------------------------------------------------------------------
# 5. AI — Google Gemini API (used by: ai-service)
# Get API key from: https://aistudio.google.com/app/apikey
# ------------------------------------------------------------------------------
GEMINI_API_KEY=AIzaSyYourGoogleGeminiApiKeyHere
SPRING_AI_GOOGLE_GENAI_API_KEY=AIzaSyYourGoogleGeminiApiKeyHere


# ------------------------------------------------------------------------------
# 6. SECURITY — JWT & Internal Service Secrets
# Generate with: openssl rand -hex 32
# JWT_SECRET must be at least 256 bits (64 hex chars)
# ------------------------------------------------------------------------------
JWT_SECRET=your_hex_encoded_jwt_secret_at_least_64_characters_long_here
INTERNAL_SERVICE_SECRET=your_shared_internal_microservice_secret_here
