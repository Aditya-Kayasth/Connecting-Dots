# ==============================================================================
# GATEWAY SERVICE - ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================

# Server Port
PORT=8080

# Redis Reactive Rate Limiting
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Security & JWT Pre-validation
JWT_SECRET=your_base64_or_hex_encoded_jwt_secret_key_must_be_at_least_256_bits_long

# Service Discovery
EUREKA_SERVER_URL=http://localhost:8761/eureka
