# ==============================================================================
# AI SERVICE - ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================

# Server Port
PORT=8082

# Google Gemini AI API Key
GEMINI_API_KEY=AIzaSyYourGoogleGeminiApiKeyHere

# Upstash QStash Webhook Signature Verification
QSTASH_CURRENT_SIGNING_KEY=sig_your_current_qstash_signing_key_here
QSTASH_NEXT_SIGNING_KEY=sig_your_next_qstash_signing_key_here

# Core Service Callback URL & Shared Secret
CORE_SERVICE_URL=http://localhost:8081
INTERNAL_SERVICE_SECRET=your_shared_internal_microservice_secret_here

# Service Discovery
EUREKA_SERVER_URL=http://localhost:8761/eureka
