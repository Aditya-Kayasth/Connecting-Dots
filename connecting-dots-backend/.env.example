# ==============================================================================
# CONNECTING DOTS - BACKEND ENVIRONMENT CONFIGURATION (.env.example)
# Copy this file to '.env' inside connecting-dots-backend.
# ==============================================================================

# 1. DATABASE CONFIGURATION (Neon PostgreSQL)
DB_URL=jdbc:postgresql://ep-example-pooler.us-east-2.aws.neon.tech/connecting_dots?sslmode=require
DB_USERNAME=connecting_dots_owner
DB_PASSWORD=your_neon_db_password_here

# 2. CACHING & RATE LIMITING (Redis)
REDIS_URL=rediss://default:your_password@your_upstash_host:6379
REDIS_HOST=your_upstash_host.upstash.io
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here

# 3. UPSTASH QSTASH ASYNCHRONOUS QUEUE & WEBHOOKS
QSTASH_URL=https://qstash.upstash.io/v2/publish/
QSTASH_TOKEN=your_upstash_qstash_bearer_token_here
QSTASH_CURRENT_SIGNING_KEY=sig_your_current_qstash_signing_key_here
QSTASH_NEXT_SIGNING_KEY=sig_your_next_qstash_signing_key_here

# 4. MICROSERVICE INTER-COMMUNICATION URLS
EUREKA_SERVER_URL=http://eureka-server:8761/eureka
CORE_SERVICE_URL=http://core-service:8081
AI_WEBHOOK_URL=http://gateway-service:8080/api/v1/ai/webhook

# 5. MEDIA STORAGE (Cloudinary SDK)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name_here
CLOUDINARY_API_KEY=your_cloudinary_api_key_here
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here

# 6. SECURITY, JWT & SERVICE SECRETS
JWT_SECRET=your_base64_or_hex_encoded_jwt_secret_key_must_be_at_least_256_bits_long
INTERNAL_SERVICE_SECRET=your_shared_internal_microservice_secret_here

# 7. ARTIFICIAL INTELLIGENCE (Google Gemini API)
GEMINI_API_KEY=AIzaSyYourGoogleGeminiApiKeyHere
